# PostgreSQL / Supabase Database Credentials
DB_URL="jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"
DB_USER="postgres.your_project_ref"
DB_PASS="replace_with_supabase_database_password"

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Optional First-Admin Bootstrap (promotes an existing registered account on startup if no ADMIN exists yet)
ADMIN_BOOTSTRAP_EMAIL=""

# JWT Secrets for Backend (must be at least 32 bytes / 256 bits)
JWT_SECRET="replace_with_a_long_secure_random_string_min_256_bits"

# AI Engine Configuration
AI_INTERNAL_TOKEN="replace_with_a_secure_token_min_16_chars"
GEMINI_API_KEY="your_google_gemini_api_key_here"
LLM_PROVIDER="gemini"
LLM_MODEL_PARSE="gemini-3.5-flash-lite"
LLM_MODEL_STUDY_KIT="gemini-3.5-flash-lite"

# Google OAuth (Sign in with Google)
# Obtain from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Microsoft / Windows Account OAuth (Sign in with Microsoft)
# Obtain from Microsoft Azure Portal / Entra ID: https://portal.azure.com/
MICROSOFT_CLIENT_ID="your_microsoft_client_id_here"
MICROSOFT_CLIENT_SECRET="your_microsoft_client_secret_here"
MICROSOFT_TENANT_ID="common"

# n8n Orchestrator Credentials
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD="replace_with_n8n_password"
INTERNAL_N8N_TOKEN="replace_with_a_secure_n8n_internal_token"
