# MySQL Database Configuration
DB_PASS=replace_with_secure_password
DB_ROOT_PASS=replace_with_secure_root_password

# JWT Secrets for Backend
JWT_SECRET=replace_with_a_long_secure_random_string_min_256_bits

# AI Engine Configuration
AI_INTERNAL_TOKEN=replace_with_a_secure_token_min_16_chars
GEMINI_API_KEY=your_google_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL_PARSE=gemini-2.5-flash
LLM_MODEL_STUDY_KIT=gemini-2.5-flash-lite
LLM_THINKING_BUDGET=0

# n8n Orchestrator Credentials
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace_with_n8n_password
